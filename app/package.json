{
  "name": "qa-javascript-framework",
  "version": "1.0.0",
  "description": "Production-ready, scalable, enterprise-grade Agentic AI driven automation framework using Playwright and Cucumber BDD",
  "main": "src/support/run-tests.js",
  "type": "module",
  "scripts": {
    "test": "node src/support/run-tests.js",
    "test:cucumber": "node src/support/run-tests.js --cucumber",
    "test:cucumber:tag": "node src/support/run-tests.js --cucumber --tags",
    "test:cucumber:feature": "node src/support/run-tests.js --cucumber",
    "test:cucumber:folder": "node src/support/run-tests.js --cucumber",
    "test:playwright": "node src/support/run-tests.js --playwright",
    "test:playwright:tag": "node src/support/run-tests.js --playwright --grep",
    "test:playwright:spec": "node src/support/run-tests.js --playwright",
    "test:playwright:folder": "node src/support/run-tests.js --playwright",
    "test:playwright:ui": "npx playwright test --ui",
    "test:playwright:config": "npx playwright test --config=playwright.config.js",
    "test:playwright:config:ui": "npx playwright test --config=playwright.config.js --ui",
    "test:all": "npm run test:cucumber && npm run test:playwright",
    "allure:generate": "node src/support/generate-allure.js",
    "allure:pdf": "node src/support/generate-allure.js",
    "allure:open": "allure open test-results/reports/allure-report",
    "allure": "npm run allure:generate && npm run allure:open",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.6.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.62",
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.2",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.10.0",
    "oracledb": "^6.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "playwright": "^1.44.1",
    "qe-framework-core": "file:qe-framework-core-1.0.40.tgz",
    "tedious": "^18.2.0",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.62",
    "allure-commandline": "^2.41.0",
    "allure-cucumberjs": "^3.0.0-beta.10",
    "allure-js-commons": "^3.0.0-beta.10",
    "allure-playwright": "^3.9.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}