{
  "name": "app-test-automation-framework",
  "version": "1.0.0",
  "description": "App Test Automation integrated with Enterprise-grade Playwright-BDD test automation framework",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node src/support/run-tests.js",
    "test:tag": "node src/support/run-tests.js",
    "test:spec": "node src/support/run-tests.js",
    "test:ui": "node src/support/run-tests.js --ui",
    "test:report": "npx playwright show-report test-results/report-${npm_package_config_env:-demo-app}",
    "bddgen": "bddgen test",
    "lint": "eslint src --ext .js,.jsx"
  },
  "keywords": [
    "playwright",
    "bdd",
    "testing",
    "automation",
    "e2e",
    "qa",
    "gherkin"
  ],
  "author": "QE Team",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0",
    "playwright-bdd": "^9.2.0",
    "qe-framework-core": "file:qe-framework-core-1.0.45.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0"
  }
}
