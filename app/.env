# Common Execution Configuration
# These values are used as defaults across all environments
# Environment-specific values can override these in respective YAML files

# Application Selection
APP=app
ENV=demo-app

# Browser Configuration
BROWSER=Chrome
HEADLESS=false
SLOW_MO=0

# Execution Settings
PARALLEL=0
TIMEOUT=90000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
RETRY=0

# Logging in Files (true/false)
LOGGER=true

#Networking Recording
MOCK_RECORD=true
MOCK_PLAYBACK=false
MOCK_INTERCEPT_PATTERN=**/api/**
MOCK_SKIP_ENDPOINTS=/assets/,/images/,/fonts/
MOCK_RECORD_ENDPOINTS=
#api/dashboard/stats,/api/products


# Screenshot and Video Recording
# off, on, only-on-failure
SCREENSHOT=only-on-failure
# off, on, retain-on-failure, on-first-retry
VIDEO=off
# off, on, retain-on-failure, on-first-retry
TRACE=off
